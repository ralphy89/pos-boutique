APP_NAME="POS Boutique API"
ENV="dev"

# For demo/dev only; set a long random value in production
JWT_SECRET="change-me-super-secret"
JWT_ALG="HS256"
ACCESS_TOKEN_EXPIRES_MINUTES=60

# SQLite database file. Default is next to the app; for durability on another disk/USB/NAS,
# point to an absolute path (forward slashes on Windows). Create the folder before first run.
#
# Examples (Windows):
#   DATABASE_URL="sqlite:///D:/POS-Backup/pos_boutique.db"
#   DATABASE_URL="sqlite:////NAS/share/pos_boutique.db"
#
# Keep the external volume connected while the API runs; unplugging during a write can corrupt the DB.
DATABASE_URL="sqlite:///./pos_boutique.db"
